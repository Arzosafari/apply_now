# ---------------------------------------------------------------------------
# FaraTech environment configuration
# Copy this file to `.env` and replace every placeholder before deployment.
# Never commit real credentials.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
APP_ORIGIN=http://127.0.0.1:5173
PUBLIC_SITE_URL=http://127.0.0.1:5173

# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_TTL_HOURS=12

# Initial administrator, used only when the database is first seeded.
# Change immediately after the first login and remove the password from .env.
SEED_ADMIN_NAME=Site Administrator
SEED_ADMIN_EMAIL=admin@faratech.example
SEED_ADMIN_PASSWORD=ChangeMe!2026

# Demo pricing currency. All payment amounts are stored in minor units.
DEFAULT_CURRENCY=USD

# ---- Stripe Checkout (optional until online payments are required) ---------
# Get test keys at https://dashboard.stripe.com/test/apikeys.
# The secret key must never be exposed to the browser.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://127.0.0.1:5173/payment/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://127.0.0.1:5173/payment/cancelled

# ---- Email notifications (optional) ---------------------------------------
# The contact and consultation flows always save to the database first.
# Configure a transactional email provider before enabling notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICATION_FROM=
NOTIFICATION_TO=

# Set to true only after replacing every sample phone number, address,
# social link, team profile and success metric in Admin -> Settings.
PUBLIC_CONTENT_VERIFIED=false

# Uploaded image storage (relative to project root)
UPLOAD_DIR=public/uploads
MAX_UPLOAD_MB=5
